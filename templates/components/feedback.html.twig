{# components/feedback.html.twig — Widget "Cet article vous a ete utile ?"
   Attend une variable `article` (entite Article).
   Controleur Stimulus "feedback" pour l'envoi AJAX.
#}
<div class="bg-[#ffffff] rounded-2xl border border-[rgba(0,0,0,0.06)] p-6 mt-10"
     data-controller="feedback"
     data-feedback-article-id-value="{{ article.id }}"
     data-feedback-url-value="{{ path('front_article_feedback', {id: article.id}) }}">

    {# Etat initial : question + boutons #}
    <div data-feedback-target="question">
        <p class="text-sm font-medium text-[#2d3748] mb-4">
            Cet article vous a ete utile ?
        </p>

        <div class="flex items-center gap-3">
            {# Bouton Oui (pouce en haut) #}
            <button type="button"
                    class="inline-flex items-center gap-2 rounded-xl border border-[rgba(0,0,0,0.06)] bg-[#fafbfc] px-4 py-2 text-sm font-medium text-[#2d3748]/70 hover:border-[#635bff]/30 hover:bg-[#635bff]/5 hover:text-[#635bff] transition-all"
                    data-action="feedback#vote" data-helpful="true">
                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.633 10.25c.806 0 1.533-.446 2.031-1.08a9.041 9.041 0 0 1 2.861-2.4c.723-.384 1.35-.956 1.653-1.715a4.498 4.498 0 0 0 .322-1.672V2.75a.75.75 0 0 1 .75-.75 2.25 2.25 0 0 1 2.25 2.25c0 1.152-.26 2.243-.723 3.218-.266.558.107 1.282.725 1.282m0 0h3.126c1.026 0 1.945.694 2.054 1.715.045.422.068.85.068 1.285a11.95 11.95 0 0 1-2.649 7.521c-.388.482-.987.729-1.605.729H13.48c-.483 0-.964-.078-1.423-.23l-3.114-1.04a4.501 4.501 0 0 0-1.423-.23H5.904m10.598-9.75H14.25M5.904 18.5c.083.205.173.405.27.602.197.4-.078.898-.523.898h-.908c-.889 0-1.713-.518-1.972-1.368a12 12 0 0 1-.521-3.507c0-1.553.295-3.036.831-4.398C3.387 9.953 4.167 9.5 5 9.5h1.053c.472 0 .745.556.5.96a8.958 8.958 0 0 0-1.302 4.665c0 1.194.232 2.333.654 3.375Z" />
                </svg>
                Oui
            </button>

            {# Bouton Non (pouce en bas) #}
            <button type="button"
                    class="inline-flex items-center gap-2 rounded-xl border border-[rgba(0,0,0,0.06)] bg-[#fafbfc] px-4 py-2 text-sm font-medium text-[#2d3748]/70 hover:border-red-300 hover:bg-red-50 hover:text-red-600 transition-all"
                    data-action="feedback#vote" data-helpful="false">
                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7.498 15.25H4.372c-1.026 0-1.945-.694-2.054-1.715A12.137 12.137 0 0 1 2.25 12c0-2.848.992-5.464 2.649-7.521C5.287 3.997 5.886 3.75 6.504 3.75h4.016a4.5 4.5 0 0 1 1.423.23l3.114 1.04a4.5 4.5 0 0 0 1.423.23h1.294M7.498 15.25c.618 0 .991.724.725 1.282A7.471 7.471 0 0 0 7.5 19.75 2.25 2.25 0 0 0 9.75 22a.75.75 0 0 0 .75-.75v-.633c0-.573.11-1.14.322-1.672.304-.76.93-1.33 1.653-1.715a9.04 9.04 0 0 0 2.86-2.4c.498-.634 1.226-1.08 2.032-1.08h.384m-10.253 1.5H9.7m8.075-9.75c.01.05.027.1.05.148.593 1.2.925 2.55.925 3.977 0 1.487-.36 2.89-.999 4.125m.023-8.25c-.076-.365.183-.75.575-.75h.908c.889 0 1.713.518 1.972 1.368.339 1.11.521 2.287.521 3.507 0 1.553-.295 3.036-.831 4.398-.306.774-1.086 1.227-1.918 1.227h-1.053c-.472 0-.745-.556-.5-.96a8.95 8.95 0 0 0 .303-.54" />
                </svg>
                Non
            </button>
        </div>
    </div>

    {# Formulaire de commentaire (affiche quand "Non" est clique) #}
    <div class="hidden" data-feedback-target="negativeForm">
        <p class="text-sm font-medium text-[#2d3748] mb-2">
            Que pourrions-nous ameliorer ?
        </p>
        <p class="text-xs text-[#2d3748]/50 mb-3">
            Vos commentaires nous aident a ameliorer notre documentation.
        </p>

        <textarea
            rows="3"
            placeholder="Decrivez ce qui pourrait etre ameliore..."
            class="w-full rounded-xl border border-[rgba(0,0,0,0.06)] bg-[#fafbfc] px-4 py-3 text-sm text-[#2d3748] placeholder-[#2d3748]/40 focus:outline-none focus:ring-2 focus:ring-[#635bff]/30 focus:border-transparent resize-none transition-all"
            data-feedback-target="comment"
        ></textarea>

        <div class="flex items-center gap-3 mt-3">
            <button type="button"
                    class="inline-flex items-center rounded-xl bg-[#635bff] px-4 py-2 text-sm font-medium text-white hover:bg-[#635bff]/90 transition-colors"
                    data-action="feedback#submitNegative">
                Envoyer
            </button>
            <button type="button"
                    class="inline-flex items-center rounded-xl px-4 py-2 text-sm font-medium text-[#2d3748]/50 hover:text-[#2d3748] transition-colors"
                    data-action="feedback#cancel">
                Annuler
            </button>
        </div>
    </div>

    {# Message de confirmation #}
    <div class="hidden" data-feedback-target="thankYou">
        <div class="flex items-center gap-2 text-sm text-[#635bff]">
            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            <span class="font-medium">Merci pour votre retour !</span>
        </div>
    </div>
</div>
