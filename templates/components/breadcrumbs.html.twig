{# components/breadcrumbs.html.twig — Fil d'Ariane
   Attend une variable `breadcrumbs` : tableau de {label, url}
   Le dernier element represente la page courante (pas de lien).
#}
{% if breadcrumbs is defined and breadcrumbs|length > 0 %}
<nav aria-label="Fil d'Ariane" class="px-4 sm:px-6 lg:px-8 py-3">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm">
        {# Lien accueil #}
        <li class="flex items-center">
            <a href="{{ path('front_home') }}" class="text-[#2d3748]/50 hover:text-[#635bff] transition-colors">
                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955a1.126 1.126 0 0 1 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                </svg>
            </a>
        </li>

        {% for crumb in breadcrumbs %}
            {# Separateur #}
            <li class="flex items-center text-[#2d3748]/30" aria-hidden="true">
                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                </svg>
            </li>

            <li class="flex items-center">
                {% if not loop.last %}
                    <a href="{{ crumb.url }}" class="text-[#2d3748]/50 hover:text-[#635bff] transition-colors">
                        {{ crumb.label }}
                    </a>
                {% else %}
                    <span class="text-[#2d3748] font-medium" aria-current="page">
                        {{ crumb.label }}
                    </span>
                {% endif %}
            </li>
        {% endfor %}
    </ol>
</nav>
{% endif %}
