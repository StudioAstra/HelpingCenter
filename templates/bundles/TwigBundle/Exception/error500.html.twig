{% extends 'base.html.twig' %}

{% block title %}Erreur — Centre d'aide StudioAstra{% endblock %}
{% block meta_description %}Une erreur est survenue. Veuillez réessayer plus tard.{% endblock %}

{% block body %}
<section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <div class="mb-8 text-8xl font-extrabold text-[#635bff]/20 font-satoshi">500</div>
    <h1 class="font-satoshi text-3xl font-bold text-[#2d3748] md:text-4xl">
        Erreur serveur
    </h1>
    <p class="mt-4 text-lg text-[#2d3748]/60">
        Une erreur inattendue est survenue. Nous travaillons à la résoudre.
    </p>
    <div class="mt-8">
        <a href="{{ path('front_home') }}"
           class="btn btn-primary inline-flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1"/>
            </svg>
            Retour à l'accueil
        </a>
    </div>
</section>
{% endblock %}
