{% extends 'base.html.twig' %}

{% block title %}{{ section.title }} — Centre d'aide StudioAstra{% endblock %}
{% block meta_description %}{{ section.description ?? 'Consultez les articles de la section ' ~ section.title ~ ' dans le centre d\'aide StudioAstra.' }}{% endblock %}

{% block body %}
{# ── Breadcrumbs ── #}
{% include 'components/breadcrumbs.html.twig' with {breadcrumbs: [
    {label: 'Accueil', url: path('front_home')},
    {label: section.title, url: null}
]} %}

{# ── Section Header ── #}
<section class="mx-auto max-w-7xl px-4 pt-8 pb-4">
    <div class="flex items-start gap-4">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-[#635bff]/10 text-[#635bff]">
            {% if section.icon is defined and section.icon %}
                <span class="text-2xl">{{ section.icon }}</span>
            {% else %}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-6l-2-2H5a2 2 0 0 0-2 2z"/>
                </svg>
            {% endif %}
        </div>
        <div>
            <h1 class="font-satoshi text-3xl font-extrabold text-[#1f2937]">{{ section.title }}</h1>
            {% if section.description is defined and section.description %}
                <p class="mt-2 text-base text-[#2d3748]/80">{{ section.description }}</p>
            {% endif %}
        </div>
    </div>
</section>

{# ── Subsection Cards Grid ── #}
<section class="mx-auto max-w-7xl px-4 py-8">
    {% if sectionArticles is defined and sectionArticles|length > 0 %}
        <div class="mb-8 rounded-2xl border border-[rgba(0,0,0,0.10)] bg-white p-6 shadow-sm">
            <h2 class="font-satoshi text-xl font-bold text-[#1f2937]">Articles de cette section</h2>
            <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
                {% for article in sectionArticles %}
                    <a href="{{ path('front_article_section', {sectionSlug: section.slug, articleSlug: article.slug}) }}"
                       class="group block rounded-xl border border-[rgba(0,0,0,0.10)] bg-white p-4 transition hover:-translate-y-0.5 hover:border-[#635bff]/30 hover:shadow-sm">
                        <div class="text-xs font-medium text-[#2d3748]/65">Section</div>
                        <h3 class="mt-1 font-satoshi text-base font-bold text-[#1f2937] group-hover:text-[#635bff]">
                            {{ article.title }}
                        </h3>
                        {% if article.searchText %}
                            <p class="mt-2 text-sm text-[#2d3748]/80">
                                {{ article.searchText|length > 120 ? article.searchText|slice(0, 120) ~ '...' : article.searchText }}
                            </p>
                        {% endif %}
                    </a>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {% if section.subsections|length > 0 %}
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {% for sub in section.subsections %}
                <div class="rounded-2xl border border-[rgba(0,0,0,0.10)] bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
                    {% set publishedSubArticles = sub.articles|filter(a => a.isPublished) %}
                    <a href="{{ path('front_subsection', {sectionSlug: section.slug, subsectionSlug: sub.slug}) }}"
                       class="block">
                        <h2 class="font-satoshi text-lg font-bold text-[#1f2937] hover:text-[#635bff]">
                            {{ sub.title }}
                        </h2>
                    </a>
                    {% if sub.description is defined and sub.description %}
                        <p class="mt-1 text-sm text-[#2d3748]/80">{{ sub.description }}</p>
                    {% endif %}
                    <p class="mt-3 text-xs font-medium text-[#2d3748]/65">
                        {{ publishedSubArticles|length }} article{{ publishedSubArticles|length > 1 ? 's' : '' }}
                    </p>

                    {# Article Cards #}
                    {% if publishedSubArticles|length > 0 %}
                        <div class="mt-4 grid grid-cols-1 gap-3 border-t border-[rgba(0,0,0,0.10)] pt-3">
                            {% for article in publishedSubArticles %}
                                <a href="{{ path('front_article', {sectionSlug: section.slug, subsectionSlug: sub.slug, articleSlug: article.slug}) }}"
                                   class="group block rounded-xl border border-[rgba(0,0,0,0.10)] bg-white p-4 transition hover:-translate-y-0.5 hover:border-[#635bff]/30 hover:shadow-sm">
                                    <h3 class="font-satoshi text-sm font-bold text-[#1f2937] group-hover:text-[#635bff]">
                                        {{ article.title }}
                                    </h3>
                                    {% if article.searchText %}
                                        <p class="mt-1 text-xs text-[#2d3748]/80">
                                            {{ article.searchText|length > 90 ? article.searchText|slice(0, 90) ~ '...' : article.searchText }}
                                        </p>
                                    {% endif %}
                                </a>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="py-16 text-center">
            <p class="text-lg text-[#2d3748]/75">Aucune sous-section pour le moment.</p>
        </div>
    {% endif %}
</section>
{% endblock %}
