{% extends 'base.html.twig' %}

{% block title %}Recherche : {{ query }} — Centre d'aide StudioAstra{% endblock %}
{% block meta_description %}Résultats de recherche pour « {{ query }} » dans le centre d'aide StudioAstra.{% endblock %}

{% block body %}
{# ── Breadcrumbs ── #}
{% include 'components/breadcrumbs.html.twig' with {breadcrumbs: [
    {label: 'Accueil', url: path('front_home')},
    {label: 'Recherche', url: null}
]} %}

{# ── Search Header ── #}
<section class="mx-auto max-w-4xl px-4 pt-8 pb-4">
    <h1 class="font-satoshi text-3xl font-extrabold text-[#2d3748]">Résultats de recherche</h1>

    {% if query %}
        <p class="mt-2 text-base text-[#2d3748]/60">
            Recherche pour « <span class="font-semibold text-[#2d3748]">{{ query }}</span> »
        </p>
    {% endif %}

    {# ── Search Bar ── #}
    <form method="get" action="{{ path('front_search') }}" class="mt-6">
        <div class="relative">
            <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-[#2d3748]/40">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 1 0 4.5 12a7.5 7.5 0 0 0 12.15 4.65z"/>
                </svg>
            </span>
            <input
                type="text"
                name="q"
                value="{{ query }}"
                placeholder="Rechercher dans le centre d'aide..."
                class="w-full rounded-2xl border border-[rgba(0,0,0,0.06)] bg-white py-4 pl-12 pr-4 text-[#2d3748] shadow-sm placeholder:text-[#2d3748]/40 focus:outline-none focus:ring-2 focus:ring-[#635bff]/40"
            />
        </div>
    </form>
</section>

{# ── Results ── #}
<section class="mx-auto max-w-4xl px-4 py-8">
    {% if results is defined and results|length > 0 %}
        {# Result Count #}
        <p class="mb-6 text-sm font-medium text-[#2d3748]/50">
            {{ results|length }} résultat{{ results|length > 1 ? 's' : '' }} trouvé{{ results|length > 1 ? 's' : '' }}
        </p>

        <div class="space-y-4">
            {% for result in results %}
                {% set section = result.section %}
                {% set subsection = result.subsection %}
                <a href="{{ subsection
                    ? path('front_article', {sectionSlug: section.slug, subsectionSlug: subsection.slug, articleSlug: result.slug})
                    : path('front_article_section', {sectionSlug: section.slug, articleSlug: result.slug}) }}"
                   class="group block rounded-2xl border border-[rgba(0,0,0,0.06)] bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                    <div class="flex items-start gap-4">
                        {# Document Icon #}
                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#635bff]/10 text-[#635bff]">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2z"/>
                            </svg>
                        </div>

                        <div class="min-w-0 flex-1">
                            {# Article Title #}
                            <h2 class="font-satoshi text-lg font-bold text-[#2d3748] group-hover:text-[#635bff]">
                                {{ result.title }}
                            </h2>

                            {# Section > Subsection Path #}
                            <p class="mt-1 flex items-center gap-1 text-xs text-[#2d3748]/40">
                                <span>{{ section.title }}</span>
                                {% if subsection %}
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                                    </svg>
                                    <span>{{ subsection.title }}</span>
                                {% endif %}
                            </p>

                            {# Preview #}
                            {% if result.excerpt is defined and result.excerpt %}
                                <p class="mt-2 text-sm text-[#2d3748]/60">{{ result.excerpt }}</p>
                            {% endif %}
                        </div>

                        {# Arrow #}
                        <span class="shrink-0 text-[#2d3748]/20 transition group-hover:text-[#635bff]">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                            </svg>
                        </span>
                    </div>
                </a>
            {% endfor %}
        </div>
    {% else %}
        {# No Results #}
        <div class="py-16 text-center">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-[#f0f4f8]">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-[#2d3748]/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 1 0 4.5 12a7.5 7.5 0 0 0 12.15 4.65z"/>
                </svg>
            </div>
            <p class="text-lg text-[#2d3748]/50">
                Aucun résultat trouvé pour « <span class="font-semibold text-[#2d3748]">{{ query }}</span> ».
            </p>
            <p class="mt-1 text-sm text-[#2d3748]/40">Essayez d'autres termes.</p>
        </div>
    {% endif %}
</section>
{% endblock %}
