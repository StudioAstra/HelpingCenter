{% extends 'base.html.twig' %}

{% block title %}{{ subsection.title }} — {{ section.title }} — Centre d'aide StudioAstra{% endblock %}
{% block meta_description %}{{ subsection.description ?? 'Consultez les articles de ' ~ subsection.title ~ ' dans le centre d\'aide StudioAstra.' }}{% endblock %}

{% block body %}
{# ── Breadcrumbs ── #}
{% include 'components/breadcrumbs.html.twig' with {breadcrumbs: [
    {label: 'Accueil', url: path('front_home')},
    {label: section.title, url: path('front_section', {sectionSlug: section.slug})},
    {label: subsection.title, url: null}
]} %}

{# ── Subsection Header ── #}
<section class="mx-auto max-w-7xl px-4 pt-8 pb-4">
    <h1 class="font-satoshi text-3xl font-extrabold text-[#1f2937]">{{ subsection.title }}</h1>
    {% if subsection.description is defined and subsection.description %}
        <p class="mt-2 text-base text-[#2d3748]/80">{{ subsection.description }}</p>
    {% endif %}
</section>

{# ── Articles List ── #}
<section class="mx-auto max-w-7xl px-4 py-8">
    {% set publishedArticles = subsection.articles|filter(a => a.isPublished) %}

    {% if publishedArticles|length > 0 %}
        <div class="space-y-4">
            {% for article in publishedArticles %}
                <a href="{{ path('front_article', {sectionSlug: section.slug, subsectionSlug: subsection.slug, articleSlug: article.slug}) }}"
                   class="group block rounded-2xl border border-[rgba(0,0,0,0.10)] bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                    <div class="flex items-start gap-4">
                        {# Document Icon #}
                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#635bff]/10 text-[#635bff]">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2z"/>
                            </svg>
                        </div>

                        <div class="min-w-0 flex-1">
                            <h2 class="font-satoshi text-lg font-bold text-[#1f2937] group-hover:text-[#635bff]">
                                {{ article.title }}
                            </h2>

                            {# Preview Text #}
                            <p class="mt-1 text-sm text-[#2d3748]/80">
                                {% if article.searchText is defined and article.searchText %}
                                    {{ article.searchText|length > 150 ? article.searchText|slice(0, 150) ~ '...' : article.searchText }}
                                {% else %}
                                    Lire l'article
                                {% endif %}
                            </p>

                            {# Published Date #}
                            {% if article.createdAt is defined and article.createdAt %}
                                <p class="mt-2 text-xs text-[#2d3748]/65">
                                    Publié le {{ article.createdAt|date('d/m/Y') }}
                                </p>
                            {% endif %}
                        </div>

                        {# Arrow #}
                        <span class="shrink-0 text-[#2d3748]/45 transition group-hover:text-[#635bff]">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                            </svg>
                        </span>
                    </div>
                </a>
            {% endfor %}
        </div>
    {% else %}
        <div class="py-16 text-center">
            <p class="text-lg text-[#2d3748]/75">Aucun article publié pour le moment.</p>
        </div>
    {% endif %}
</section>
{% endblock %}
