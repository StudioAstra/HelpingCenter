{% extends 'base.html.twig' %}

{% block title %}{{ article.title }} — Centre d'aide StudioAstra{% endblock %}
{% block meta_description %}{{ article.searchText is defined and article.searchText ? article.searchText|slice(0, 160) : 'Article d\'aide StudioAstra : ' ~ article.title }}{% endblock %}

{% block body %}
{# ── Breadcrumbs ── #}
{% set breadcrumbs = [
    {label: 'Accueil', url: path('front_home')},
    {label: section.title, url: path('front_section', {sectionSlug: section.slug})}
] %}
{% if subsection %}
    {% set breadcrumbs = breadcrumbs|merge([
        {label: subsection.title, url: path('front_subsection', {sectionSlug: section.slug, subsectionSlug: subsection.slug})}
    ]) %}
{% endif %}
{% set breadcrumbs = breadcrumbs|merge([{label: article.title, url: null}]) %}
{% include 'components/breadcrumbs.html.twig' with {breadcrumbs: breadcrumbs} %}

{# ── Two-Column Layout ── #}
<section class="mx-auto max-w-7xl px-4 py-8"
         data-controller="article-tools"
         data-article-tools-id-value="{{ article.id }}"
         data-article-tools-title-value="{{ article.title|e('html_attr') }}"
         data-article-tools-section-value="{{ section.title|e('html_attr') }}"
         data-article-tools-url-value="{{ app.request.uri }}">
    <div class="flex flex-col gap-8 lg:flex-row">

        {# ── Left Column: Main Content ── #}
        <article class="min-w-0 flex-1">
            {# Article Title #}
            <h1 class="font-satoshi text-3xl font-extrabold leading-tight text-[#2d3748] md:text-4xl">
                {{ article.title }}
            </h1>

            {# Meta #}
            <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-[#2d3748]/65">
                <span>Mis à jour le {{ article.updatedAt|date('d/m/Y') }}</span>
                <span>· {{ readingTimeMinutes }} min de lecture</span>
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium {{ freshnessTone == 'fresh' ? 'bg-green-100 text-green-700' : (freshnessTone == 'warning' ? 'bg-yellow-100 text-yellow-700' : 'bg-red-100 text-red-700') }}">
                    {{ freshnessLabel }}
                </span>
            </div>

            <div class="mt-4 flex flex-wrap items-center gap-2">
                <button type="button"
                        data-action="article-tools#copyLink"
                        class="inline-flex items-center rounded-xl border border-[rgba(0,0,0,0.10)] px-3 py-1.5 text-xs font-medium text-[#2d3748]/85 hover:bg-[#f0f4f8] transition-colors">
                    Copier le lien
                </button>
                <button type="button"
                        data-action="article-tools#shareLink"
                        class="inline-flex items-center rounded-xl border border-[rgba(0,0,0,0.10)] px-3 py-1.5 text-xs font-medium text-[#2d3748]/85 hover:bg-[#f0f4f8] transition-colors">
                    Partager
                </button>
                <span data-article-tools-target="copyStatus"
                      class="hidden text-xs text-[#635bff] font-medium"></span>
            </div>

            {% if headings is defined and headings|length > 0 %}
                <details class="mt-5 rounded-xl border border-[rgba(0,0,0,0.10)] bg-white p-4 lg:hidden">
                    <summary class="cursor-pointer text-sm font-semibold text-[#1f2937]">Sommaire</summary>
                    <ul class="mt-3 space-y-2">
                        {% for heading in headings %}
                            <li class="{{ heading.level == 3 ? 'pl-3' : '' }}">
                                <a href="#{{ heading.id }}" class="text-sm text-[#2d3748]/80 hover:text-[#635bff]">
                                    {{ heading.text }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </details>
            {% endif %}

            {# Article Body #}
            <div class="article-content mt-8 prose prose-slate max-w-none
                        prose-headings:font-satoshi prose-headings:font-bold prose-headings:text-[#2d3748]
                        prose-p:text-[#2d3748]/80 prose-p:leading-relaxed
                        prose-a:text-[#635bff] prose-a:no-underline hover:prose-a:underline
                        prose-strong:text-[#2d3748]
                        prose-code:rounded prose-code:bg-[#f0f4f8] prose-code:px-1.5 prose-code:py-0.5 prose-code:text-sm prose-code:text-[#635bff]
                        prose-pre:rounded-2xl prose-pre:bg-[#2d3748] prose-pre:text-sm
                        prose-img:rounded-2xl
                        prose-blockquote:border-[#635bff]/30 prose-blockquote:text-[#2d3748]/70
                        prose-li:text-[#2d3748]/80 [&_img]:rounded-xl">
                {{ htmlContent|raw }}
            </div>

            {# ── Feedback Widget ── #}
            <div class="mt-12">
                <div id="feedback">
                    {% include 'components/feedback.html.twig' %}
                </div>
            </div>

            <section class="mt-8 rounded-2xl border border-[rgba(0,0,0,0.10)] bg-white p-5">
                <h3 class="text-sm font-semibold text-[#1f2937]">Ce contenu a résolu votre problème ?</h3>
                <div class="mt-3 flex items-center gap-2">
                    <button type="button"
                            data-action="article-tools#markResolved"
                            class="inline-flex items-center rounded-xl bg-green-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-green-500 transition-colors">
                        Oui
                    </button>
                    <button type="button"
                            data-action="article-tools#markUnresolved"
                            class="inline-flex items-center rounded-xl border border-[rgba(0,0,0,0.10)] px-3 py-1.5 text-xs font-semibold text-[#2d3748]/85 hover:bg-[#f0f4f8] transition-colors">
                        Non, j'ai encore besoin d'aide
                    </button>
                </div>
                <p data-article-tools-target="resolvedThanks" class="hidden mt-3 text-xs font-medium text-green-700">
                    Parfait, merci pour votre retour.
                </p>
            </section>

            <section class="mt-6 rounded-2xl border border-[rgba(0,0,0,0.10)] bg-[#fafbfc] p-5">
                <h3 class="text-sm font-semibold text-[#1f2937]">Toujours bloqué ?</h3>
                <p class="mt-1 text-sm text-[#2d3748]/80">Contactez notre équipe support, en précisant l’article consulté.</p>
                <a href="mailto:support@getstudioastra.fr?subject={{ ('Besoin d aide - ' ~ article.title)|url_encode }}"
                   class="mt-3 inline-flex items-center rounded-xl bg-[#635bff] px-3 py-1.5 text-xs font-semibold text-white hover:bg-[#635bff]/90 transition-colors">
                    Contacter le support
                </a>
            </section>

            {# ── Related Articles ── #}
            {% if relatedArticles is defined and relatedArticles|length > 0 %}
                <section class="mt-10">
                    <h2 class="font-satoshi text-xl font-bold text-[#2d3748]">Vous pourriez avoir besoin</h2>
                    <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-2">
                        {% for related in relatedArticles %}
                            <a href="{{ related.subsection
                                ? path('front_article', {sectionSlug: related.section.slug, subsectionSlug: related.subsection.slug, articleSlug: related.slug})
                                : path('front_article_section', {sectionSlug: related.section.slug, articleSlug: related.slug}) }}"
                               class="group block rounded-xl border border-[rgba(0,0,0,0.10)] bg-white p-4 transition hover:-translate-y-0.5 hover:border-[#635bff]/30 hover:shadow-sm">
                                <h3 class="font-satoshi text-sm font-bold text-[#1f2937] group-hover:text-[#635bff]">
                                    {{ related.title }}
                                </h3>
                                {% if related.searchText %}
                                    <p class="mt-1 text-xs text-[#2d3748]/80">
                                        {{ related.searchText|length > 90 ? related.searchText|slice(0, 90) ~ '...' : related.searchText }}
                                    </p>
                                {% endif %}
                            </a>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}

            {# ── Previous / Next Navigation ── #}
            {% if previousArticle is defined or nextArticle is defined %}
                <nav class="mt-10 flex items-center justify-between border-t border-[rgba(0,0,0,0.10)] pt-6">
                    {# Previous #}
                    {% if previousArticle %}
                        <a href="{{ subsection
                            ? path('front_article', {sectionSlug: section.slug, subsectionSlug: subsection.slug, articleSlug: previousArticle.slug})
                            : path('front_article_section', {sectionSlug: section.slug, articleSlug: previousArticle.slug}) }}"
                           class="group flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-medium text-[#2d3748]/85 transition hover:bg-[#f0f4f8] hover:text-[#635bff]">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                            </svg>
                            <span>{{ previousArticle.title }}</span>
                        </a>
                    {% else %}
                        <span></span>
                    {% endif %}

                    {# Next #}
                    {% if nextArticle %}
                        <a href="{{ subsection
                            ? path('front_article', {sectionSlug: section.slug, subsectionSlug: subsection.slug, articleSlug: nextArticle.slug})
                            : path('front_article_section', {sectionSlug: section.slug, articleSlug: nextArticle.slug}) }}"
                           class="group flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-medium text-[#2d3748]/85 transition hover:bg-[#f0f4f8] hover:text-[#635bff]">
                            <span>{{ nextArticle.title }}</span>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                            </svg>
                        </a>
                    {% else %}
                        <span></span>
                    {% endif %}
                </nav>
            {% endif %}
        </article>

        {# ── Right Column: Table of Contents Sidebar ── #}
        <aside class="hidden w-72 shrink-0 lg:block">
            <div class="sticky top-8">
                {% include 'components/toc.html.twig' with {headings: headings} %}
            </div>
        </aside>

    </div>

    <button type="button"
            data-action="article-tools#scrollTop"
            data-article-tools-target="backToTop"
            class="hidden fixed bottom-6 right-6 z-40 rounded-full bg-[#635bff] px-4 py-2 text-xs font-semibold text-white shadow-lg hover:bg-[#4f46e5] transition">
        Retour en haut
    </button>
</section>
{% endblock %}
