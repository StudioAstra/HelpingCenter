{% extends 'admin/base.html.twig' %}

{% block title %}Importer des articles — {{ parent() }}{% endblock %}

{% block admin_title %}Importer des articles{% endblock %}

{% block admin_content %}
    <div class="max-w-3xl">
        <div class="bg-[#ffffff] rounded-2xl border border-[rgba(0,0,0,0.06)] shadow-sm p-6 lg:p-8">
            <h2 class="text-lg font-semibold text-[#2d3748] mb-4">Import ZIP</h2>

            <p class="text-sm text-[#2d3748]/60 mb-5">
                Format attendu: 1 dossier = 1 catégorie, 1 fichier <code>.md</code> = 1 article, première ligne du fichier = titre.
            </p>

            <form method="post" enctype="multipart/form-data" class="space-y-5">
                <div>
                    <label for="zip_file" class="block text-sm font-medium text-[#2d3748] mb-1.5">Fichier ZIP</label>
                    <input type="file"
                           id="zip_file"
                           name="zip_file"
                           accept=".zip,application/zip"
                           required
                           class="input w-full rounded-xl border border-[rgba(0,0,0,0.06)] bg-[#fafbfc] px-4 py-2.5 text-sm text-[#2d3748] focus:outline-none focus:ring-2 focus:ring-[#635bff]/30 focus:border-transparent transition-all">
                </div>

                <div class="flex items-center gap-3">
                    <button type="submit"
                            class="btn btn-primary inline-flex items-center gap-2 rounded-xl bg-[#635bff] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#635bff]/90 focus:outline-none focus:ring-2 focus:ring-[#635bff]/50 focus:ring-offset-2 transition-all">
                        Importer
                    </button>
                    <a href="{{ path('admin_article_index') }}"
                       class="btn btn-outline inline-flex items-center gap-2 rounded-xl border border-[rgba(0,0,0,0.06)] px-5 py-2.5 text-sm font-medium text-[#2d3748]/60 hover:bg-[#f0f4f8] hover:text-[#2d3748] transition-colors">
                        Retour
                    </a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}

