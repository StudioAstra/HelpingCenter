{# admin/article/versions.html.twig — Historique des versions d'un article
   Affiche toutes les versions avec possibilite de restaurer.
#}
{% extends 'admin/base.html.twig' %}

{% block title %}Historique des versions — {{ article.title }} — {{ parent() }}{% endblock %}

{% block admin_title %}Historique des versions{% endblock %}

{% block admin_content %}

    {# Fil d'Ariane contextuel #}
    <div class="mb-6">
        <div class="flex items-center gap-2 text-sm text-[#2d3748]/50">
            <a href="{{ path('admin_article_index') }}"
               class="hover:text-[#635bff] transition-colors">
                Articles
            </a>
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
            <a href="{{ path('admin_article_edit', { id: article.id }) }}"
               class="hover:text-[#635bff] transition-colors">
                {{ article.title }}
            </a>
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
            <span class="text-[#2d3748]">Versions</span>
        </div>
    </div>

    {# Titre #}
    <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-[#2d3748]">
            Historique des versions &mdash; {{ article.title }}
        </h2>
        <a href="{{ path('admin_article_edit', { id: article.id }) }}"
           class="inline-flex items-center gap-2 rounded-xl border border-[rgba(0,0,0,0.06)] px-4 py-2.5 text-sm font-medium text-[#2d3748]/60 hover:bg-[#f0f4f8] hover:text-[#2d3748] transition-colors">
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3" />
            </svg>
            Retour &agrave; l'article
        </a>
    </div>

    {# Tableau des versions #}
    <div class="bg-[#ffffff] rounded-2xl border border-[rgba(0,0,0,0.06)] shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-[rgba(0,0,0,0.06)]">
                        <th class="px-6 py-3 text-left text-xs font-medium text-[#2d3748]/50 uppercase tracking-wider">Version</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-[#2d3748]/50 uppercase tracking-wider">Titre</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-[#2d3748]/50 uppercase tracking-wider">Cr&eacute;&eacute; par</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-[#2d3748]/50 uppercase tracking-wider">Date</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-[#2d3748]/50 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[rgba(0,0,0,0.06)]">
                    {% for version in versions %}
                        <tr class="hover:bg-[#f0f4f8]/50 transition-colors {{ loop.first ? 'bg-green-50/30' : '' }}">
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center rounded-full bg-[#635bff]/10 px-2.5 py-0.5 text-xs font-semibold text-[#635bff]">
                                    #{{ version.versionNumber }}
                                </span>
                                {% if loop.first %}
                                    <span class="ml-2 inline-flex items-center rounded-full bg-green-50 px-2 py-0.5 text-[10px] font-medium text-green-700 uppercase">
                                        Actuelle
                                    </span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 font-medium text-[#2d3748]">
                                {{ version.title }}
                            </td>
                            <td class="px-6 py-4 text-[#2d3748]/60">
                                {{ version.createdBy }}
                            </td>
                            <td class="px-6 py-4 text-[#2d3748]/60">
                                {{ version.createdAt|date('d/m/Y H:i') }}
                            </td>
                            <td class="px-6 py-4 text-right">
                                {% if not loop.first %}
                                    <form method="post"
                                          action="{{ path('admin_article_restore', { id: article.id, versionId: version.id }) }}"
                                          data-controller="confirm-modal"
                                          data-action="submit->confirm-modal#confirm"
                                          data-confirm-modal-title-value="Restaurer la version #{{ version.versionNumber }}"
                                          data-confirm-modal-message-value="Le contenu actuel sera remplacé."
                                          data-confirm-modal-confirm-label-value="Restaurer"
                                          data-confirm-modal-variant-value="primary">
                                        <input type="hidden" name="_token" value="{{ csrf_token('restore-version-' ~ version.id) }}">
                                        <button type="submit"
                                                class="inline-flex items-center gap-1.5 rounded-lg border border-[rgba(0,0,0,0.06)] px-3 py-1.5 text-xs font-medium text-[#635bff] hover:bg-[#635bff]/5 transition-colors">
                                            <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3" />
                                            </svg>
                                            Restaurer
                                        </button>
                                    </form>
                                {% else %}
                                    <span class="text-xs text-[#2d3748]/30">Version actuelle</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-sm text-[#2d3748]/40">
                                Aucune version enregistr&eacute;e pour cet article.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

{% endblock %}
