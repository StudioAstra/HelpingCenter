{# admin/dashboard.html.twig — Tableau de bord d'administration
   Affiche les statistiques globales et les articles recents.
#}
{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard — {{ parent() }}{% endblock %}

{% block admin_title %}Dashboard{% endblock %}

{% block admin_content %}

    {# ===== Cartes de statistiques ===== #}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">

        {# Sections #}
        <div class="bg-[#ffffff] rounded-2xl border border-[rgba(0,0,0,0.06)] shadow-sm p-6">
            <div class="flex items-center gap-4">
                <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-blue-100/20">
                    <svg class="h-6 w-6 text-[#635bff]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z" />
                    </svg>
                </div>
                <div>
                    <p class="text-2xl font-bold text-[#2d3748]">{{ sectionCount }}</p>
                    <p class="text-sm text-[#2d3748]/50">Sections</p>
                </div>
            </div>
        </div>

        {# Articles #}
        <div class="bg-[#ffffff] rounded-2xl border border-[rgba(0,0,0,0.06)] shadow-sm p-6">
            <div class="flex items-center gap-4">
                <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-green-100/20">
                    <svg class="h-6 w-6 text-green-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                    </svg>
                </div>
                <div>
                    <p class="text-2xl font-bold text-[#2d3748]">{{ articleCount }}</p>
                    <p class="text-sm text-[#2d3748]/50">Articles</p>
                </div>
            </div>
        </div>

        {# Publies #}
        <div class="bg-[#ffffff] rounded-2xl border border-[rgba(0,0,0,0.06)] shadow-sm p-6">
            <div class="flex items-center gap-4">
                <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-pink-100/20">
                    <svg class="h-6 w-6 text-pink-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                </div>
                <div>
                    <p class="text-2xl font-bold text-[#2d3748]">{{ publishedCount }}</p>
                    <p class="text-sm text-[#2d3748]/50">Publi&eacute;s</p>
                </div>
            </div>
        </div>

        {# Feedbacks #}
        <div class="bg-[#ffffff] rounded-2xl border border-[rgba(0,0,0,0.06)] shadow-sm p-6">
            <div class="flex items-center gap-4">
                <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-yellow-100/20">
                    <svg class="h-6 w-6 text-yellow-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.076-4.076a1.526 1.526 0 0 1 1.037-.443 48.261 48.261 0 0 0 5.048-.37c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
                    </svg>
                </div>
                <div>
                    <p class="text-2xl font-bold text-[#2d3748]">{{ feedbackCount }}</p>
                    <p class="text-sm text-[#2d3748]/50">Feedbacks</p>
                </div>
            </div>
        </div>

    </div>

    {# ===== Articles recents ===== #}
    <div class="bg-[#ffffff] rounded-2xl border border-[rgba(0,0,0,0.06)] shadow-sm">
        <div class="px-6 py-5 border-b border-[rgba(0,0,0,0.06)]">
            <h2 class="text-base font-semibold text-[#2d3748]">Articles r&eacute;cents</h2>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-[rgba(0,0,0,0.06)]">
                        <th class="px-6 py-3 text-left text-xs font-medium text-[#2d3748]/50 uppercase tracking-wider">Titre</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-[#2d3748]/50 uppercase tracking-wider">Sous-section</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-[#2d3748]/50 uppercase tracking-wider">Statut</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-[#2d3748]/50 uppercase tracking-wider">Modifi&eacute; le</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[rgba(0,0,0,0.06)]">
                    {% for article in recentArticles %}
                        <tr class="hover:bg-[#f0f4f8]/50 transition-colors">
                            <td class="px-6 py-4">
                                <a href="{{ path('admin_article_edit', { id: article.id }) }}"
                                   class="font-medium text-[#2d3748] hover:text-[#635bff] transition-colors">
                                    {{ article.title }}
                                </a>
                            </td>
                            <td class="px-6 py-4 text-[#2d3748]/60">
                                {{ article.subsection.title }}
                            </td>
                            <td class="px-6 py-4">
                                {% if article.isPublished %}
                                    <span class="inline-flex items-center rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-medium text-green-700">
                                        Publi&eacute;
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center rounded-full bg-[#f0f4f8] px-2.5 py-0.5 text-xs font-medium text-[#2d3748]/50">
                                        Brouillon
                                    </span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 text-[#2d3748]/60">
                                {{ article.updatedAt|date('d/m/Y H:i') }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="px-6 py-12 text-center text-sm text-[#2d3748]/40">
                                Aucun article pour le moment.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

{% endblock %}
