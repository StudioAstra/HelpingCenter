{# admin/base.html.twig — Layout d'administration
   Etend base.html.twig, remplace la navbar et le footer
   par une sidebar de navigation et une barre superieure admin.
#}
{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} — Administration{% endblock %}

{# Supprime la navbar publique #}
{% block navbar %}{% endblock %}

{# Supprime le footer public #}
{% block footer %}{% endblock %}

{% block body %}
<div class="flex min-h-screen">

    {# ===== Sidebar ===== #}
    <aside class="hidden lg:flex lg:flex-col w-64 bg-[#ffffff] border-r border-[rgba(0,0,0,0.06)]">

        {# Logo #}
        <div class="flex items-center gap-2 px-6 h-16 border-b border-[rgba(0,0,0,0.06)]">
            <span class="text-lg font-bold text-[#2d3748] tracking-tight">StudioAstra</span>
            <span class="inline-flex items-center rounded-full bg-[#635bff]/10 px-2 py-0.5 text-[10px] font-semibold text-[#635bff] uppercase tracking-wider">
                Admin
            </span>
        </div>

        {# Navigation #}
        <nav class="flex-1 px-3 py-4 space-y-1">
            {% set current_route = app.request.attributes.get('_route') %}

            {# Dashboard #}
            <a href="{{ path('admin_dashboard') }}"
               class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors
                      {{ current_route starts with 'admin_dashboard' ? 'bg-[#635bff]/10 text-[#635bff]' : 'text-[#2d3748]/60 hover:bg-[#f0f4f8] hover:text-[#2d3748]' }}">
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25a2.25 2.25 0 0 1-2.25-2.25v-2.25Z" />
                </svg>
                Dashboard
            </a>

            {# Sections #}
            <a href="{{ path('admin_section_index') }}"
               class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors
                      {{ current_route starts with 'admin_section' ? 'bg-[#635bff]/10 text-[#635bff]' : 'text-[#2d3748]/60 hover:bg-[#f0f4f8] hover:text-[#2d3748]' }}">
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z" />
                </svg>
                Sections
            </a>

            {# Articles #}
            <a href="{{ path('admin_article_index') }}"
               class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors
                      {{ current_route starts with 'admin_article' ? 'bg-[#635bff]/10 text-[#635bff]' : 'text-[#2d3748]/60 hover:bg-[#f0f4f8] hover:text-[#2d3748]' }}">
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                </svg>
                Articles
            </a>
        </nav>

        {# Bas de sidebar : lien vers le site public #}
        <div class="px-3 py-4 border-t border-[rgba(0,0,0,0.06)]">
            <a href="{{ path('app_home') }}"
               class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-[#2d3748]/60 hover:bg-[#f0f4f8] hover:text-[#2d3748] transition-colors">
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
                Voir le site
            </a>
        </div>
    </aside>

    {# ===== Contenu principal ===== #}
    <div class="flex-1 flex flex-col min-w-0">

        {# Barre superieure #}
        <header class="flex items-center justify-between h-16 px-6 bg-[#ffffff] border-b border-[rgba(0,0,0,0.06)]">

            {# Bouton hamburger mobile #}
            <button type="button"
                    class="lg:hidden inline-flex items-center justify-center rounded-xl p-2 text-[#2d3748]/60 hover:bg-[#f0f4f8] transition-colors"
                    data-action="admin-sidebar#toggle"
                    aria-label="Ouvrir le menu">
                <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                </svg>
            </button>

            {# Titre de la page #}
            <h1 class="text-lg font-semibold text-[#2d3748]">
                {% block admin_title %}Dashboard{% endblock %}
            </h1>

            {# Utilisateur + deconnexion #}
            <div class="flex items-center gap-4">
                <span class="text-sm text-[#2d3748]/60">
                    {{ app.user.email|default('Admin') }}
                </span>
                <a href="{{ path('app_logout') }}"
                   class="inline-flex items-center gap-1.5 rounded-xl border border-[rgba(0,0,0,0.06)] px-3 py-1.5 text-sm font-medium text-[#2d3748]/60 hover:bg-[#f0f4f8] hover:text-[#2d3748] transition-colors">
                    <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15m-3 0-3-3m0 0 3-3m-3 3H15" />
                    </svg>
                    Deconnexion
                </a>
            </div>
        </header>

        {# Zone de contenu #}
        <div class="flex-1 bg-[#fafbfc] p-6 lg:p-8">
            {# Messages flash #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 rounded-xl px-4 py-3 text-sm font-medium
                                {{ label == 'success' ? 'bg-green-50 text-green-700 border border-green-200' : '' }}
                                {{ label == 'error' ? 'bg-red-50 text-red-700 border border-red-200' : '' }}
                                {{ label == 'warning' ? 'bg-yellow-50 text-yellow-700 border border-yellow-200' : '' }}
                                {{ label == 'info' ? 'bg-blue-50 text-blue-700 border border-blue-200' : '' }}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block admin_content %}{% endblock %}
        </div>
    </div>
</div>
{% endblock %}
