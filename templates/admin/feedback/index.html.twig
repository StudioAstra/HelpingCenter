{% extends 'admin/base.html.twig' %}

{% block title %}Feedbacks — {{ parent() }}{% endblock %}

{% block admin_title %}Feedbacks{% endblock %}

{% block admin_content %}
    <div class="mb-6">
        <h2 class="text-xl font-bold text-[#2d3748]">Retours utilisateurs</h2>
    </div>

    <div class="bg-[#ffffff] rounded-2xl border border-[rgba(0,0,0,0.06)] shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-[rgba(0,0,0,0.06)]">
                        <th class="px-6 py-3 text-left text-xs font-medium text-[#2d3748]/50 uppercase tracking-wider">Date</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-[#2d3748]/50 uppercase tracking-wider">Article</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-[#2d3748]/50 uppercase tracking-wider">Avis</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-[#2d3748]/50 uppercase tracking-wider">Commentaire</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-[#2d3748]/50 uppercase tracking-wider">IP</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[rgba(0,0,0,0.06)]">
                    {% for feedback in feedbacks %}
                        <tr class="hover:bg-[#f0f4f8]/50 transition-colors">
                            <td class="px-6 py-4 text-[#2d3748]/60 whitespace-nowrap">
                                {{ feedback.createdAt|date('d/m/Y H:i') }}
                            </td>
                            <td class="px-6 py-4">
                                <a href="{{ path('admin_article_edit', { id: feedback.article.id }) }}"
                                   class="font-medium text-[#2d3748] hover:text-[#635bff] transition-colors">
                                    {{ feedback.article.title }}
                                </a>
                            </td>
                            <td class="px-6 py-4">
                                {% if feedback.isHelpful %}
                                    <span class="inline-flex items-center rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-medium text-green-700">
                                        Utile
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-medium text-red-700">
                                        Pas utile
                                    </span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 text-[#2d3748]/70">
                                {{ feedback.comment ?: '—' }}
                            </td>
                            <td class="px-6 py-4 text-[#2d3748]/50 font-mono text-xs">
                                {{ feedback.ipAddress }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-sm text-[#2d3748]/40">
                                Aucun feedback pour le moment.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

