###############################################
# Stage 1 – Composer dependencies
###############################################
FROM composer:2 AS vendor

WORKDIR /app
COPY composer.json composer.lock symfony.lock ./
RUN composer install \
    --no-dev --no-scripts --no-autoloader --prefer-dist --ignore-platform-reqs

COPY . .
RUN composer dump-autoload --optimize --classmap-authoritative

###############################################
# Stage 2 – Frontend assets (Node)
###############################################
FROM node:20-alpine AS assets

WORKDIR /app
COPY package.json package-lock.json webpack.config.js postcss.config.js tailwind.config.js ./
RUN npm ci

COPY assets ./assets
COPY templates ./templates
RUN npm run build

###############################################
# Stage 3 – PHP-FPM (app)
###############################################
FROM php:8.2-fpm-alpine AS app

RUN apk add --no-cache icu-libs libzip libpng libjpeg-turbo freetype \
    && apk add --no-cache --virtual .build-deps \
        icu-dev libzip-dev libpng-dev libjpeg-turbo-dev freetype-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) intl pdo_mysql zip gd opcache \
    && apk del .build-deps

COPY .docker/php/php-prod.ini $PHP_INI_DIR/conf.d/zz-prod.ini

WORKDIR /var/www/html

COPY --from=vendor /app/vendor ./vendor
COPY --from=assets /app/public/build ./public/build
COPY . .

COPY .docker/php/entrypoint.prod.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

RUN mkdir -p var/cache var/log \
    && chown -R www-data:www-data var

ENTRYPOINT ["entrypoint.sh"]
CMD ["php-fpm"]

###############################################
# Stage 4 – Nginx (static files only)
###############################################
FROM nginx:1.25-alpine AS nginx

COPY .docker/nginx/default.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=assets /app/public /var/www/html/public
